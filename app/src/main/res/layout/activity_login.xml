<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEDDF">

    <!-- Khối Logo góc trái trên -->
    <LinearLayout
        android:id="@+id/ll_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartOrder"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Khoảng trắng dự trữ cho ảnh 3D -->
    <ImageView
        android:id="@+id/img_delivery_3d"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:scaleType="fitCenter"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-20dp"
        app:layout_constraintTop_toBottomOf="@id/ll_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Vùng bo tròn màu trắng chứa các form đăng nhập -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        android:layout_marginTop="-24dp"
        android:layout_marginBottom="-20dp"
        app:layout_constraintTop_toBottomOf="@id/img_delivery_3d"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/tv_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chào mừng trở lại"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1E1E1E"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Ô nhập Email/Phone -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_email"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#F5F6F8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_welcome">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="#888888"/>
                        <EditText
                            android:id="@+id/edt_email"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="Email hoặc Số điện thoại"
                            android:textColorHint="#888888"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cảnh báo lỗi Email (Ban đầu ẩn) -->
                <TextView
                    android:id="@+id/tv_error_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/cv_email" />

                <!-- Ô nhập Mật khẩu -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_password"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#F5F6F8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_error_email">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_secure"
                            app:tint="#888888"/>
                        <EditText
                            android:id="@+id/edt_password"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="Mật khẩu"
                            android:textColorHint="#888888"
                            android:textSize="14sp"
                            android:inputType="textPassword"/>
                        <ImageView
                            android:id="@+id/iv_password_toggle"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#888888"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cảnh báo lỗi Mật khẩu (Ban đầu ẩn) -->
                <TextView
                    android:id="@+id/tv_error_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/cv_password" />

                <!-- Ghi nhớ đăng nhập & Quên mật khẩu -->
                <CheckBox
                    android:id="@+id/cb_keep_signed_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duy trì đăng nhập"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginTop="8dp"
                    app:buttonTint="#F26C22"
                    app:layout_constraintTop_toBottomOf="@id/tv_error_password"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quên mật khẩu?"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#F26C22"
                    app:layout_constraintTop_toTopOf="@id/cb_keep_signed_in"
                    app:layout_constraintBottom_toBottomOf="@id/cb_keep_signed_in"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Nút Đăng nhập -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Đăng nhập"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:backgroundTint="#F26C22"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/cb_keep_signed_in" />

                <!-- Dòng kẻ Hoặc tiếp tục với -->
                <LinearLayout
                    android:id="@+id/ll_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/btn_login">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E0E0E0"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoặc tiếp tục với"
                        android:textSize="12sp"
                        android:textColor="#A0A0A0"
                        android:layout_marginHorizontal="12dp"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E0E0E0"/>
                </LinearLayout>

                <!-- 2 Nút Đăng nhập Mạng xã hội -->
                <LinearLayout
                    android:id="@+id/ll_social"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_divider">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_google"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Google"
                        android:textColor="#1E1E1E"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#F5F6F8"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_apple"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Apple"
                        android:textColor="#1E1E1E"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#F5F6F8"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Đăng ký tài khoản -->
                <LinearLayout
                    android:id="@+id/ll_signup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_social"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có tài khoản? "
                        android:textSize="12sp"
                        android:textColor="#888888"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đăng ký"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1E1E1E"/>
                </LinearLayout>

                <!-- Truy cập khách -->
                <TextView
                    android:id="@+id/tv_guest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiếp tục với tư cách Khách ➔"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#F26C22"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_signup"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>