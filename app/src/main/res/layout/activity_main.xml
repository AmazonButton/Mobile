<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Chiếc xe -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_scooter"
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:lottie_rawRes="@raw/scooter_anim"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <!-- Khối Tiêu đề 2 màu (Ban đầu ẩn với alpha = 0) -->
    <LinearLayout
        android:id="@+id/ll_splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:alpha="0"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/lottie_scooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E" /> <!-- Màu đen -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#F27C22" /> <!-- Màu cam -->
    </LinearLayout>

    <!-- Mô tả Ứng dụng tiếng Anh (Ban đầu ẩn với alpha = 0) -->
    <TextView
        android:id="@+id/tv_splash_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Gửi hàng, theo dõi và giao mọi món hàng quanh thành phố - chỉ với một nút bấm."
        android:textSize="16sp"
        android:textColor="#888888"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/ll_splash_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>