{
    "version": 1,
    "hooks": {
        "beforeShellExecution": [
            {
                "command": "node \"$CURSOR_PROJECT_DIR/.cursor/kit-hooks/guard-rails.mjs\" --platform cursor",
                "timeout": 10
            }
        ],
        "beforeReadFile": [
            {
                "command": "node \"$CURSOR_PROJECT_DIR/.cursor/kit-hooks/guard-rails.mjs\" --platform cursor",
                "timeout": 10
            }
        ],
        "beforeSubmitPrompt": [
            {
                "command": "node \"$CURSOR_PROJECT_DIR/.cursor/kit-hooks/dev-rules-reminder.mjs\"",
                "timeout": 10
            }
        ]
    }
}
